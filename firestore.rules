rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só usuários autenticados (logados) podem ler ou escrever qualquer dado.
    // Isso é o que realmente impede acesso ao banco por estranhos -
    // as chaves do firebaseConfig NÃO são segredo, quem protege o banco são estas regras.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
